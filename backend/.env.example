# Server
PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/aeroprep
JWT_SECRET=change-me

# AI — set a key and a model; the provider is picked from the key.
# Works with Anthropic (sk-ant-...), OpenAI (sk-...), OpenRouter (sk-or-...), Groq (gsk_...), Gemini (AIza...).
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional
# AI_PROVIDER=anthropic   # anthropic | openai | openrouter | gemini | groq | ollama | custom — overrides detection
# AI_BASE_URL=            # required for "custom" (any OpenAI-compatible endpoint); overrides the default elsewhere
AI_EFFORT=low             # Anthropic only: low | medium | high. Lower is faster and uses fewer tokens

# Usage limits (all optional; defaults shown)
# FREE_INTERVIEW_LIMIT=3     # interviews each user may start; override per user with User.interviewLimit
# INTERVIEW_MINUTES=15       # interview length, counted from the candidate's first answer
# INTERVIEW_MAX_ANSWERS=12   # answers per interview; each one is one model call
# CODING_MAX_RUNS=5          # "Run & Check" evaluations per coding challenge

# ImageKit (resume uploads; leave empty to run with manual entry only)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
