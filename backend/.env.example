# Server
PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/aeroprep
JWT_SECRET=change-me

# AI — set a key and a model; the provider is picked from the key.
# Works with Anthropic (sk-ant-...), OpenAI (sk-...), OpenRouter (sk-or-...), Groq (gsk_...), Gemini (AIza...).
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Optional
# AI_MODEL_FAST=claude-haiku-5-5   # a quicker, cheaper model for the live interview turns only
# AI_PROVIDER=anthropic   # anthropic | openai | openrouter | gemini | groq | ollama | custom — overrides detection
# AI_BASE_URL=            # required for "custom" (any OpenAI-compatible endpoint); overrides the default elsewhere
AI_EFFORT=low             # Anthropic only: low | medium | high. Lower is faster and uses fewer tokens

# Usage limits (all optional; defaults shown)
# DAILY_INTERVIEW_LIMIT=100  # interviews that may be started per day across all users (a spending ceiling)
# FREE_INTERVIEW_LIMIT=3     # interviews each user may start; override per user with User.interviewLimit
# INTERVIEW_MINUTES=15       # interview length, counted from the candidate's first answer
# INTERVIEW_MAX_ANSWERS=12   # answers per interview; each one is one model call
# CODING_MAX_RUNS=5          # code checks per coding challenge
# INTERVIEW_MAX_FAILED_CALLS=6  # model calls per interview that may fail after possibly being paid for
#                               (timeouts, unusable replies) before it stops making calls
# AI_REPLY_TIMEOUT_MS=30000  # how long the interviewer may take over one reply before it is given up on

# The interviewer's voice (optional). Without a key the pages use the browser's built-in voice.
# With one, every visitor hears the same natural voice and nothing is downloaded.
# VOICE_API_KEY=            # key for the speech service
# VOICE_PROVIDER=azure      # azure (default) | openai (any service with OpenAI's /audio/speech API)
# VOICE_REGION=centralindia # azure only: the region the key belongs to
# VOICE_NAME=en-US-AndrewNeural   # which voice (en-IN-PrabhatNeural is an Indian English male voice)
# VOICE_DAILY_CHARS=15000   # characters spoken per day across all users before falling back to the browser voice

# Security (optional)
# CORS_ORIGINS=https://your-domain.com   # extra sites allowed to call this API, comma separated
# MONITOR_TOKEN=                         # when set, /monitor and /metrics need ?token=<value>

# Support and feedback
# SUPPORT_EMAIL=hailhelixnewsform@gmail.com   # shown to users; in-app feedback is emailed here
# SMTP_USER=                                  # Gmail address that sends the feedback emails
# SMTP_PASS=                                  # its app password (Google Account > Security > App passwords)
