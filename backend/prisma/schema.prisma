// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  name       String
  email      String      @unique
  password   String
  // Interviews this user may start; null means the free default (FREE_INTERVIEW_LIMIT)
  interviewLimit Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  interviews Interview[]
  appFeedback AppFeedback[]
}

model Interview {
  id              Int              @id @default(autoincrement())
  userId          Int
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeURL       String?
  resumeText      String?
  jobDescription  String?
  // Experience level the candidate chose (intern | junior | mid | senior); null lets the interviewer judge
  level           String?
  status          String           @default("in_progress")
  // Set on the candidate's first answer; started interviews count against the user's limit
  startedAt       DateTime?
  endedAt         DateTime?
  inputTokens     Int              @default(0)
  outputTokens    Int              @default(0)
  // Model calls that failed after they may have been paid for. At the cap in limits.js the
  // interview makes no more calls, so a failure cannot be repeated without end
  failedCalls     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        Message[]
  questions       Question[]
  codingChallenge CodingChallenge?
  feedback        Feedback?
}

// What users say about the product after an interview
model AppFeedback {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewId Int?
  rating      Int // 1-5
  message     String
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Live interview transcript, in order
model Message {
  id          Int       @id @default(autoincrement())
  interviewId Int
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  speaker     String // "ai" | "user"
  text        String
  createdAt   DateTime  @default(now())

  @@index([interviewId])
}

model Question {
  id             Int       @id @default(autoincrement())
  interviewId    Int
  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionText   String
  expectedAnswer String
  userAnswer     String?
  // The report's note on this answer: what was strong or missing
  feedback       String?
  order          Int
  createdAt      DateTime  @default(now())
}

model CodingChallenge {
  id               Int       @id @default(autoincrement())
  interviewId      Int       @unique
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  title            String
  description      String
  problemStatement String
  constraints      String?
  language         String
  starterCode      String?
  testCases        Json?
  userCode         String?
  passed           Boolean?
  aiFeedback       String?
  // Last evaluation ({ passed, feedback, testResults }) and how many evaluations were spent
  result           Json?
  runs             Int       @default(0)
  skipped          Boolean   @default(false)
  createdAt        DateTime  @default(now())
}

model Feedback {
  id               Int       @id @default(autoincrement())
  interviewId      Int       @unique
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  totalScore       Int
  interviewScore   Int
  codingScore      Int
  strengths        String[]
  weaknesses       String[]
  detailedFeedback String
  recommendation   String
  createdAt        DateTime  @default(now())
}